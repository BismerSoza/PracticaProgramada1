@model PracticaProgramada1.Models.CursoModel

@{
    ViewData["Title"] = "Editar Curso";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h3 class="mb-0">
                Editar Curso
            </h3>
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Editar"
                  method="post">

                <input asp-for="IdCurso"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="IdProfesor"
                           class="form-label">
                        Profesor
                    </label>

                    <select asp-for="IdProfesor"
                            asp-items="ViewBag.Profesores"
                            class="form-select">

                        <option value="">
                            Seleccione un profesor
                        </option>

                    </select>

                    <span asp-validation-for="IdProfesor"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="NombreCurso"
                           class="form-label">
                        Nombre del curso
                    </label>

                    <input asp-for="NombreCurso"
                           class="form-control"
                           maxlength="150" />

                    <span asp-validation-for="NombreCurso"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Descripcion"
                           class="form-label">
                        Descripción
                    </label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="4"
                              maxlength="500"></textarea>

                    <span asp-validation-for="Descripcion"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-check mb-3">

                    <input asp-for="Estado"
                           class="form-check-input" />

                    <label asp-for="Estado"
                           class="form-check-label">
                        Curso activo
                    </label>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar cambios
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
