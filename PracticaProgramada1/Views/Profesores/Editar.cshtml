@model PracticaProgramada1.Models.ProfesorModel

<div class="section-header">
    <h1>Editar Profesor</h1>
</div>

<div class="card">

    <div class="card-body">

        <form asp-action="Editar">

            <input asp-for="IdProfesor" type="hidden" />
            <input asp-for="IdUsuario" type="hidden" />

            <div class="row">

                <div class="form-group col-md-4">
                    <label>Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                </div>

                <div class="form-group col-md-4">
                    <label>Primer Apellido</label>
                    <input asp-for="PrimerApellido" class="form-control" />
                </div>

                <div class="form-group col-md-4">
                    <label>Segundo Apellido</label>
                    <input asp-for="SegundoApellido" class="form-control" />
                </div>

            </div>

            <div class="row">

                <div class="form-group col-md-6">
                    <label>Identificación</label>
                    <input asp-for="Identificacion" class="form-control" />
                </div>

                <div class="form-group col-md-6">
                    <label>Correo</label>
                    <input asp-for="Correo" class="form-control" />
                </div>

            </div>

            <div class="row">

                <div class="form-group col-md-6">
                    <label>Teléfono</label>
                    <input asp-for="Telefono" class="form-control" />
                </div>

                <div class="form-group col-md-6">
                    <label>Especialidad</label>
                    <input asp-for="Especialidad" class="form-control" />
                </div>

            </div>

            <button class="btn btn-primary">
                Guardar
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Regresar
            </a>

        </form>

    </div>

</div>
