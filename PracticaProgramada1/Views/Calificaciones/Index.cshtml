@model IEnumerable<PracticaProgramada1.Models.CalificacionModel>

@{
    ViewData["Title"] = "Calificaciones";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Lista de Calificaciones</h2>

        <a asp-action="Registrar"
           class="btn btn-success">
            Nueva Calificación
        </a>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay calificaciones registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Estudiante</th>
                        <th>Curso</th>
                        <th>Nota</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.IdCalificacion</td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Estudiante))
                                {
                                    @item.Estudiante
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Matrícula #@item.IdMatricula
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.NombreCurso))
                                {
                                    @item.NombreCurso
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin información
                                    </span>
                                }
                            </td>

                            <td>
                                @item.Nota.ToString("0.##")
                            </td>

                            <td>
                                @item.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>

                            <td>

                                <a asp-action="Detalle"
                                   asp-route-id="@item.IdCalificacion"
                                   class="btn btn-info btn-sm">
                                    Detalle
                                </a>

                                <a asp-action="Editar"
                                   asp-route-id="@item.IdCalificacion"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Eliminar"
                                   asp-route-id="@item.IdCalificacion"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('¿Desea eliminar esta calificación?');">
                                    Eliminar
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>