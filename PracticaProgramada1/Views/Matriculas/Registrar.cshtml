@model PracticaProgramada1.Models.MatriculaModel

@{
    ViewData["Title"] = "Registrar Matrícula";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">
                Registrar Matrícula
            </h3>
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Registrar"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="IdEstudiante"
                           class="form-label">
                        Estudiante
                    </label>

                    <select asp-for="IdEstudiante"
                            asp-items="ViewBag.Estudiantes"
                            class="form-select">

                        <option value="">
                            Seleccione un estudiante
                        </option>

                    </select>

                    <span asp-validation-for="IdEstudiante"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="IdCurso"
                           class="form-label">
                        Curso
                    </label>

                    <select asp-for="IdCurso"
                            asp-items="ViewBag.Cursos"
                            class="form-select">

                        <option value="">
                            Seleccione un curso
                        </option>

                    </select>

                    <span asp-validation-for="IdCurso"
                          class="text-danger">
                    </span>

                </div>

                <input asp-for="FechaMatricula"
                       type="hidden" />

                <input asp-for="Estado"
                       type="hidden"
                       value="true" />

                <button type="submit"
                        class="btn btn-success">
                    Guardar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}