@model PracticaProgramada1.Models.MatriculaModel

@{
    ViewData["Title"] = "Editar Matrícula";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">
            <h3 class="mb-0">
                Editar Matrícula
            </h3>
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Editar"
                  method="post">

                <input asp-for="IdMatricula"
                       type="hidden" />

                <input asp-for="FechaMatricula"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="IdEstudiante"
                           class="form-label">
                        Estudiante
                    </label>

                    <select asp-for="IdEstudiante"
                            asp-items="ViewBag.Estudiantes"
                            class="form-select">

                        <option value="">
                            Seleccione un estudiante
                        </option>

                    </select>

                    <span asp-validation-for="IdEstudiante"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="IdCurso"
                           class="form-label">
                        Curso
                    </label>

                    <select asp-for="IdCurso"
                            asp-items="ViewBag.Cursos"
                            class="form-select">

                        <option value="">
                            Seleccione un curso
                        </option>

                    </select>

                    <span asp-validation-for="IdCurso"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-check mb-3">

                    <input asp-for="Estado"
                           class="form-check-input" />

                    <label asp-for="Estado"
                           class="form-check-label">
                        Matrícula activa
                    </label>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar cambios
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}