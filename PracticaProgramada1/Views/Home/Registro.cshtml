@model PracticaProgramada1.Models.RegistroEstudianteModel

<div id="app">
    <section class="section">
        <div class="container mt-5">
            <div class="row">
                <div class="col-12 col-sm-10 offset-sm-1 col-md-10 offset-md-1 col-lg-10 offset-lg-1">

                    <div class="login-brand">
                        <a asp-action="Index" asp-controller="Home">
                            <img src="/img/stisla.png" alt="logo" width="100" class="shadow-light rounded-circle">
                        </a>
                    </div>

                    <div class="card card-primary">

                        <div class="card-header">
                            <h4>Registrar Estudiante</h4>
                        </div>

                        <div class="card-body">

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger">
                                    @ViewBag.Error
                                </div>
                            }

                            <form asp-action="Registro" asp-controller="Home" method="post">

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="row">

                                    <div class="form-group col-md-4">
                                        <label>Nombre</label>
                                        <input asp-for="Nombre" class="form-control" />
                                        <span asp-validation-for="Nombre" class="text-danger"></span>
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label>Primer Apellido</label>
                                        <input asp-for="PrimerApellido" class="form-control" />
                                        <span asp-validation-for="PrimerApellido" class="text-danger"></span>
                                    </div>

                                    <div class="form-group col-md-4">
                                        <label>Segundo Apellido</label>
                                        <input asp-for="SegundoApellido" class="form-control" />
                                        <span asp-validation-for="SegundoApellido" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="form-group col-md-6">
                                        <label>Identificación</label>
                                        <input asp-for="Identificacion" class="form-control" />
                                        <span asp-validation-for="Identificacion" class="text-danger"></span>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label>Correo Electrónico</label>
                                        <input asp-for="Correo" class="form-control" />
                                        <span asp-validation-for="Correo" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="form-group col-md-6">
                                        <label>Teléfono</label>
                                        <input asp-for="Telefono" class="form-control" />
                                        <span asp-validation-for="Telefono" class="text-danger"></span>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label>Dirección</label>
                                        <input asp-for="Direccion" class="form-control" />
                                        <span asp-validation-for="Direccion" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row">

                                    <div class="form-group col-md-6">
                                        <label>Contraseña</label>
                                        <input asp-for="Contrasenna" type="password" class="form-control" />
                                        <span asp-validation-for="Contrasenna" class="text-danger"></span>
                                    </div>

                                    <div class="form-group col-md-6">
                                        <label>Confirmar Contraseña</label>
                                        <input asp-for="ConfirmarContrasenna" type="password" class="form-control" />
                                        <span asp-validation-for="ConfirmarContrasenna" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="form-group mt-3">
                                    <button type="submit" class="btn btn-primary btn-lg btn-block">
                                        Registrar Usuario
                                    </button>
                                </div>

                                <div class="text-center mt-4">
                                    ¿Ya tiene una cuenta?
                                    <a asp-action="Index" asp-controller="Home">
                                        Iniciar Sesión
                                    </a>
                                </div>

                            </form>

                        </div>

                    </div>

                    <div class="simple-footer">
                        @DateTime.Now.Year &copy; Stisla
                    </div>

                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


