@model PracticaProgramada1.Models.GeneralDashboardViewModel

@{
    ViewData["Title"] = "Panel General - Escuela Aurora";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<!-- Banner Principal Escuela Aurora -->
<div class="row">
    <div class="col-12">
        <div class="card bg-gradient-aurora shadow-lg border-0 mb-4">
            <div class="card-body p-5 text-center">
                <div class="mb-3">
                    <i class="fas fa-school fa-4x text-white"></i>
                </div>
                <h1 class="text-white display-4 font-weight-bold">@Model.TituloEscuela</h1>
                <p class="text-white-50 lead mb-4">@Model.Lema</p>
                <div class="row text-white mt-4">
                    <div class="col-md-3">
                        <h3>@Model.Resumen.TotalEstudiantes</h3>
                        <small>Estudiantes</small>
                    </div>
                    <div class="col-md-3">
                        <h3>@Model.Resumen.TotalProfesores</h3>
                        <small>Profesores</small>
                    </div>
                    <div class="col-md-3">
                        <h3>@Model.Resumen.TotalCursos</h3>
                        <small>Cursos Activos</small>
                    </div>
                    <div class="col-md-3">
                        <h3>@Model.Resumen.PromedioGeneralEscuela.ToString("0.0")</h3>
                        <small>Promedio General</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Indicadores Clave (KPIs) -->
<div class="row">
    <div class="col-xl-3 col-lg-6">
        <div class="card card-stats shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <h5 class="card-title text-uppercase text-muted mb-0">Tasa de Aprobación</h5>
                        <span class="h2 font-weight-bold mb-0">@Model.Resumen.TasaAprobacion.ToString("0.0")%</span>
                    </div>
                    <div class="col-auto">
                        <div class="icon icon-shape bg-success text-white rounded-circle shadow">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </div>
                <p class="mt-3 mb-0 text-muted text-sm">
                    <span class="text-success mr-2"><i class="fas fa-arrow-up"></i> 3.5%</span>
                    <span class="text-nowrap">vs mes anterior</span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-6">
        <div class="card card-stats shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <h5 class="card-title text-uppercase text-muted mb-0">Tasa de Asistencia</h5>
                        <span class="h2 font-weight-bold mb-0">@Model.Resumen.TasaAsistencia.ToString("0.0")%</span>
                    </div>
                    <div class="col-auto">
                        <div class="icon icon-shape bg-info text-white rounded-circle shadow">
                            <i class="fas fa-user-check"></i>
                        </div>
                    </div>
                </div>
                <p class="mt-3 mb-0 text-muted text-sm">
                    <span class="text-success mr-2"><i class="fas fa-arrow-up"></i> 2.1%</span>
                    <span class="text-nowrap">vs semana anterior</span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-6">
        <div class="card card-stats shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <h5 class="card-title text-uppercase text-muted mb-0">Nuevos Estudiantes</h5>
                        <span class="h2 font-weight-bold mb-0">@Model.Resumen.EstudiantesNuevosEsteMes</span>
                    </div>
                    <div class="col-auto">
                        <div class="icon icon-shape bg-warning text-white rounded-circle shadow">
                            <i class="fas fa-user-plus"></i>
                        </div>
                    </div>
                </div>
                <p class="mt-3 mb-0 text-muted text-sm">
                    <span class="text-nowrap">Este mes</span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-lg-6">
        <div class="card card-stats shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <h5 class="card-title text-uppercase text-muted mb-0">Total Aulas</h5>
                        <span class="h2 font-weight-bold mb-0">@Model.Resumen.TotalAulas</span>
                    </div>
                    <div class="col-auto">
                        <div class="icon icon-shape bg-danger text-white rounded-circle shadow">
                            <i class="fas fa-door-open"></i>
                        </div>
                    </div>
                </div>
                <p class="mt-3 mb-0 text-muted text-sm">
                    <span class="text-nowrap">Disponibles</span>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos y Estadísticas -->
<div class="row">
    <!-- Gráfico de Inscripciones Mensuales -->
    <div class="col-lg-8 col-md-12 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white border-0">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="mb-0"><i class="fas fa-chart-line text-primary"></i> Tendencia de Inscripciones</h3>
                    </div>
                    <div class="col text-right">
                        <select class="form-control form-control-sm" style="width: auto; display: inline-block;">
                            <option>Últimos 12 meses</option>
                            <option>Último año</option>
                            <option>Este semestre</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="chartInscripciones" height="100"></canvas>
            </div>
        </div>
    </div>

    <!-- Top 5 Mejores Estudiantes -->
    <div class="col-lg-4 col-md-12 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white border-0">
                <h3 class="mb-0"><i class="fas fa-trophy text-warning"></i> Top Estudiantes</h3>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var estudiante in Model.MejoresEstudiantes.Take(5))
                    {
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="badge badge-@(estudiante.Posicion == 1 ? "warning" : estudiante.Posicion == 2 ? "secondary" : estudiante.Posicion == 3 ? "danger" : "primary") badge-pill">
                                        #@estudiante.Posicion
                                    </span>
                                </div>
                                <div class="col-auto">
                                    <img src="@estudiante.FotoUrl" alt="@estudiante.NombreCompleto" class="avatar rounded-circle">
                                </div>
                                <div class="col ml--2">
                                    <h4 class="mb-0">
                                        @estudiante.NombreCompleto
                                    </h4>
                                    <small class="text-muted">@estudiante.Grado</small>
                                </div>
                                <div class="col-auto">
                                    <span class="badge badge-success">@estudiante.PromedioGeneral.ToString("0.00")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Próximos Eventos y Anuncios -->
<div class="row">
    <!-- Calendario de Eventos -->
    <div class="col-lg-6 col-md-12 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4><i class="fas fa-calendar-alt text-info"></i> Próximos Eventos</h4>
                <div class="card-header-action">
                    <a href="#" class="btn btn-primary btn-sm">Ver Calendario</a>
                </div>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    @foreach (var evento in Model.ProximosEventos.Take(5))
                    {
                        <li class="media mb-3">
                            <div class="mr-3">
                                <div class="text-center bg-@(evento.Tipo == "examen" ? "danger" : evento.Tipo == "reunion" ? "warning" : evento.Tipo == "festivo" ? "success" : "info") text-white rounded p-2" style="width: 60px;">
                                    <div class="h5 mb-0">@evento.FechaInicio.Day</div>
                                    <small>@evento.FechaInicio.ToString("MMM", new System.Globalization.CultureInfo("es-ES"))</small>
                                </div>
                            </div>
                            <div class="media-body">
                                <h6 class="mt-0 mb-1">@evento.Titulo</h6>
                                <p class="text-muted mb-0">@evento.Descripcion</p>
                                <small class="text-muted">
                                    <i class="fas fa-clock"></i> @evento.FechaInicio.ToString("HH:mm")
                                </small>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Anuncios Importantes -->
    <div class="col-lg-6 col-md-12 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4><i class="fas fa-bullhorn text-danger"></i> Anuncios Importantes</h4>
            </div>
            <div class="card-body">
                @foreach (var anuncio in Model.AnunciosRecientes.Take(4))
                {
                    <div class="card mb-3 @(anuncio.Importante ? "border-warning" : "")">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between">
                                <h6 class="mb-1">
                                    @if (anuncio.Importante)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    @anuncio.Titulo
                                </h6>
                                <small class="text-muted">@anuncio.FechaPublicacion.ToString("dd/MM/yyyy")</small>
                            </div>
                            <p class="text-muted mb-2 small">@anuncio.Contenido</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="fas fa-user"></i> @anuncio.Autor
                                </small>
                                <span class="badge badge-primary">@anuncio.Categoria</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-aurora {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .card-stats {
            border: none;
            border-radius: 10px;
        }

        .icon-shape {
            width: 48px;
            height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .avatar {
            width: 40px;
            height: 40px;
            object-fit: cover;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Gráfico de Inscripciones Mensuales
        var ctx = document.getElementById('chartInscripciones').getContext('2d');
        var chartInscripciones = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
                datasets: [{
                    label: 'Inscripciones',
                    data: [65, 78, 90, 102, 95, 110, 125, 118, 135, 142, 138, 150],
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    borderColor: 'rgba(102, 126, 234, 1)',
                    borderWidth: 2,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: 'rgba(102, 126, 234, 1)',
                    pointHoverBackgroundColor: 'rgba(102, 126, 234, 1)',
                    pointHoverBorderColor: '#ffffff',
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            borderDash: [5, 5]
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    </script>
}
