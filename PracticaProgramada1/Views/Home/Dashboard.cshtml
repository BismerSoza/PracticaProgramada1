@model PracticaProgramada1.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - " + Model.RolUsuario;
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<!-- Header personalizado -->
<div class="row">
    <div class="col-12">
        <div class="card card-hero shadow-sm mb-4">
            <div class="card-header bg-gradient-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="text-white mb-1">
                            <i class="fas fa-tachometer-alt mr-2"></i>
                            Bienvenido, @Model.NombreUsuario
                        </h4>
                        <p class="text-white-50 mb-0">
                            <i class="fas fa-user-tag mr-1"></i> @Model.RolUsuario | 
                            <i class="fas fa-calendar mr-1"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                        </p>
                    </div>
                    <div>
                        <button class="btn btn-light btn-sm" onclick="location.reload()">
                            <i class="fas fa-sync-alt"></i> Actualizar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Widgets según Rol -->
<div class="row">
    @foreach (var widget in Model.Widgets)
    {
        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 col-xs-12">
            <div class="card card-statistic-1 shadow-sm">
                <div class="card-icon bg-@widget.ColorClase">
                    <i class="@widget.Icono"></i>
                </div>
                <div class="card-wrap">
                    <div class="card-header">
                        <h4>@widget.Titulo</h4>
                    </div>
                    <div class="card-body">
                        <h2 class="mb-1">@widget.Valor</h2>
                        @if (!string.IsNullOrEmpty(widget.Tendencia))
                        {
                            <small class="text-@(widget.Tendencia == "up" ? "success" : widget.Tendencia == "down" ? "danger" : "muted")">
                                <i class="fas fa-arrow-@(widget.Tendencia == "up" ? "up" : widget.Tendencia == "down" ? "down" : "right")"></i>
                                @widget.PorcentajeCambio.ToString("0.0")% @widget.Descripcion
                            </small>
                        }
                        else
                        {
                            <small class="text-muted">@widget.Descripcion</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Dashboard específico por Rol -->
@if (Model.IdRol == 1) // Administrador
{
    <partial name="_DashboardAdministrador" model="Model" />
}
else if (Model.IdRol == 2) // Profesor
{
    <partial name="_DashboardProfesor" model="Model" />
}
else if (Model.IdRol == 3) // Estudiante
{
    <partial name="_DashboardEstudiante" model="Model" />
}
else
{
    <partial name="_DashboardUsuario" model="Model" />
}

<!-- Sección de Notificaciones y Actividad Reciente -->
<div class="row mt-4">
    <!-- Actividades Recientes -->
    <div class="col-lg-8 col-md-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4><i class="fas fa-history text-primary"></i> Actividad Reciente</h4>
            </div>
            <div class="card-body">
                <div class="activities">
                    @if (Model.ActividadesRecientes.Any())
                    {
                        @foreach (var actividad in Model.ActividadesRecientes.Take(8))
                        {
                            <div class="activity">
                                <div class="activity-icon bg-@actividad.ColorClase text-white shadow-@actividad.ColorClase">
                                    <i class="@actividad.Icono"></i>
                                </div>
                                <div class="activity-detail">
                                    <div class="mb-2">
                                        <span class="text-job text-@actividad.ColorClase">@actividad.Fecha.ToString("HH:mm")</span>
                                        <span class="bullet"></span>
                                        <a class="text-job" href="@actividad.Enlace">Ver detalles</a>
                                    </div>
                                    <p><strong>@actividad.Titulo</strong></p>
                                    <p class="text-muted">@actividad.Descripcion</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-3x mb-3"></i>
                            <p>No hay actividades recientes</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Notificaciones -->
    <div class="col-lg-4 col-md-12">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4><i class="fas fa-bell text-warning"></i> Notificaciones</h4>
                <div class="card-header-action">
                    <a href="#" class="btn btn-primary btn-sm">Ver Todas</a>
                </div>
            </div>
            <div class="card-body p-0">
                <ul class="list-unstyled list-unstyled-border">
                    @if (Model.Notificaciones.Any())
                    {
                        @foreach (var notificacion in Model.Notificaciones.Take(5))
                        {
                            <li class="media @(notificacion.Leida ? "" : "bg-light")">
                                <div class="media-body ml-3">
                                    <div class="text-@notificacion.Tipo font-weight-bold">
                                        @notificacion.Titulo
                                        @if (!notificacion.Leida)
                                        {
                                            <span class="badge badge-@notificacion.Tipo">Nuevo</span>
                                        }
                                    </div>
                                    <div class="text-small text-muted">
                                        @notificacion.Mensaje
                                        <div class="bullet"></div>
                                        <span class="text-time">@notificacion.Fecha.ToString("dd/MM HH:mm")</span>
                                    </div>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="media">
                            <div class="media-body text-center py-4 text-muted">
                                <i class="fas fa-check-circle fa-2x mb-2"></i>
                                <p>No hay notificaciones pendientes</p>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-hero {
            border: none;
            border-radius: 10px;
        }
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .card-statistic-1 {
            border: none;
            border-radius: 10px;
            transition: transform 0.2s;
        }
        .card-statistic-1:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.1) !important;
        }
        .activities .activity {
            padding: 15px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .activities .activity:last-child {
            border-bottom: none;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Script para actualizar datos en tiempo real (opcional)
        setInterval(function() {
            console.log('Dashboard actualizado');
        }, 60000); // Cada minuto
    </script>
}
