@model PracticaProgramada1.Models.DashboardViewModel

<!-- Dashboard Específico para Administrador -->
<div class="row">
    <!-- Gráfico de Rendimiento Académico -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4><i class="fas fa-chart-bar text-success"></i> Rendimiento Académico por Materia</h4>
            </div>
            <div class="card-body">
                <canvas id="chartRendimiento" height="80"></canvas>
            </div>
        </div>
    </div>

    <!-- Gráfico de Asistencia Semanal -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4><i class="fas fa-chart-pie text-info"></i> Asistencia Semanal</h4>
            </div>
            <div class="card-body">
                <canvas id="chartAsistencia" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Accesos Rápidos para Administrador -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4><i class="fas fa-rocket text-primary"></i> Accesos Rápidos</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 col-sm-6 mb-3">
                        <a href="/Estudiantes/Gestionar" class="btn btn-outline-primary btn-block btn-lg">
                            <i class="fas fa-user-graduate fa-2x mb-2 d-block"></i>
                            Gestionar Estudiantes
                        </a>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <a href="/Profesores/Gestionar" class="btn btn-outline-success btn-block btn-lg">
                            <i class="fas fa-chalkboard-teacher fa-2x mb-2 d-block"></i>
                            Gestionar Profesores
                        </a>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <a href="/Cursos/Gestionar" class="btn btn-outline-info btn-block btn-lg">
                            <i class="fas fa-book fa-2x mb-2 d-block"></i>
                            Gestionar Cursos
                        </a>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <a href="/Reportes" class="btn btn-outline-warning btn-block btn-lg">
                            <i class="fas fa-file-chart-line fa-2x mb-2 d-block"></i>
                            Ver Reportes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Gráfico de Rendimiento Académico
        var ctxRendimiento = document.getElementById('chartRendimiento').getContext('2d');
        var chartRendimiento = new Chart(ctxRendimiento, {
            type: 'bar',
            data: {
                labels: ['Matemáticas', 'Español', 'Ciencias', 'Estudios Sociales', 'Inglés', 'Educación Física'],
                datasets: [{
                    label: 'Promedio',
                    data: [@Model.Metricas.RendimientoPorMateria.Count > 0 ? string.Join(",", Model.Metricas.RendimientoPorMateria.Select(r => r.Promedio)) : "85, 78, 82, 90, 75, 88"],
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.6)',
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(255, 206, 86, 0.6)',
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(153, 102, 255, 0.6)',
                        'rgba(255, 159, 64, 0.6)'
                    ],
                    borderColor: [
                        'rgba(255, 99, 132, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(255, 206, 86, 1)',
                        'rgba(75, 192, 192, 1)',
                        'rgba(153, 102, 255, 1)',
                        'rgba(255, 159, 64, 1)'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });

        // Gráfico de Asistencia
        var ctxAsistencia = document.getElementById('chartAsistencia').getContext('2d');
        var chartAsistencia = new Chart(ctxAsistencia, {
            type: 'doughnut',
            data: {
                labels: ['Presentes', 'Ausentes', 'Tardíos'],
                datasets: [{
                    data: [@Model.Metricas.TasaAsistencia, @(100 - Model.Metricas.TasaAsistencia - 5), 5],
                    backgroundColor: [
                        'rgba(40, 167, 69, 0.8)',
                        'rgba(220, 53, 69, 0.8)',
                        'rgba(255, 193, 7, 0.8)'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}
