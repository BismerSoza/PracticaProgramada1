@model PracticaProgramada1.Models.RegistroEstudianteModel

@{
    ViewData["Title"] = "Registrar Estudiante";
}

<div class="section-header">

    <h1>Registrar Estudiante</h1>

</div>

<div class="section-body">

    <div class="card">

        <div class="card-header">

            <h4>
                Información del estudiante
            </h4>

        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">

                    <i class="fas fa-exclamation-circle"></i>

                    @ViewBag.Error

                </div>
            }

            <form asp-controller="Estudiantes"
                  asp-action="Registrar"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="form-group col-md-4">

                        <label asp-for="Nombre">
                            Nombre
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-group col-md-4">

                        <label asp-for="PrimerApellido">
                            Primer apellido
                        </label>

                        <input asp-for="PrimerApellido"
                               class="form-control"
                               maxlength="30" />

                        <span asp-validation-for="PrimerApellido"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-group col-md-4">

                        <label asp-for="SegundoApellido">
                            Segundo apellido
                        </label>

                        <input asp-for="SegundoApellido"
                               class="form-control"
                               maxlength="30" />

                        <span asp-validation-for="SegundoApellido"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="form-group col-md-6">

                        <label asp-for="Identificacion">
                            Identificación
                        </label>

                        <input asp-for="Identificacion"
                               class="form-control"
                               maxlength="20" />

                        <span asp-validation-for="Identificacion"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-group col-md-6">

                        <label asp-for="Correo">
                            Correo
                        </label>

                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               maxlength="150" />

                        <span asp-validation-for="Correo"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="form-group col-md-6">

                        <label asp-for="Telefono">
                            Teléfono
                        </label>

                        <input asp-for="Telefono"
                               class="form-control"
                               maxlength="20" />

                        <span asp-validation-for="Telefono"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-group col-md-6">

                        <label asp-for="Direccion">
                            Dirección
                        </label>

                        <input asp-for="Direccion"
                               class="form-control"
                               maxlength="250" />

                        <span asp-validation-for="Direccion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="form-group col-md-6">

                        <label asp-for="Contrasenna">
                            Contraseña
                        </label>

                        <input asp-for="Contrasenna"
                               type="password"
                               class="form-control"
                               minlength="6"
                               maxlength="100" />

                        <span asp-validation-for="Contrasenna"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-group col-md-6">

                        <label asp-for="ConfirmarContrasenna">
                            Confirmar contraseña
                        </label>

                        <input asp-for="ConfirmarContrasenna"
                               type="password"
                               class="form-control"
                               minlength="6"
                               maxlength="100" />

                        <span asp-validation-for="ConfirmarContrasenna"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save"></i>
                    Registrar estudiante

                </button>

                <a asp-controller="Estudiantes"
                   asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left"></i>
                    Regresar

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
