@model IEnumerable<PracticaProgramada1.Models.EstudianteModel>

@{
    ViewData["Title"] = "Estudiantes";
}

<div class="section-header
    d-flex
    justify-content-between
    align-items-center">

    <h1>Estudiantes</h1>

    <div>

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left"></i>
            Volver

        </a>

        <a asp-controller="Estudiantes"
           asp-action="Registrar"
           class="btn btn-primary">

            <i class="fas fa-plus"></i>
            Nuevo estudiante

        </a>

    </div>

</div>

<div class="section-body">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success
            alert-dismissible
            fade show"
             role="alert">

            <i class="fas fa-check-circle"></i>

            @TempData["Mensaje"]

            <button type="button"
                    class="close"
                    data-dismiss="alert"
                    aria-label="Cerrar">

                <span aria-hidden="true">
                    &times;
                </span>

            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible
            fade show"
             role="alert">

            <i class="fas fa-exclamation-circle"></i>

            @TempData["Error"]

            <button type="button"
                    class="close"
                    data-dismiss="alert"
                    aria-label="Cerrar">

                <span aria-hidden="true">
                    &times;
                </span>

            </button>

        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">

            <i class="fas fa-exclamation-circle"></i>

            @ViewBag.Error

        </div>
    }

    <div class="card">

        <div class="card-header">

            <h4>Listado de estudiantes</h4>

        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">

                    No hay estudiantes registrados.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                        table-striped
                        table-hover">

                        <thead>

                            <tr>

                                <th>Nombre</th>

                                <th>Identificación</th>

                                <th>Correo</th>

                                <th>Teléfono</th>

                                <th>Estado</th>

                                <th style="width:260px;">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                var nombreCompleto =
                                    $"{item.Nombre} " +
                                    $"{item.PrimerApellido} " +
                                    $"{item.SegundoApellido}";

                                nombreCompleto =
                                    nombreCompleto
                                        .Replace("  ", " ")
                                        .Trim();

                                <tr>

                                    <td>
                                        @nombreCompleto
                                    </td>

                                    <td>
                                        @item.Identificacion
                                    </td>

                                    <td>
                                        @item.Correo
                                    </td>

                                    <td>
                                        @item.Telefono
                                    </td>

                                    <td>

                                        @if (item.Estado)
                                        {
                                            <span class="badge badge-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">
                                                Inactivo
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="Estudiantes"
                                           asp-action="Editar"
                                           asp-route-id="@item.IdEstudiante"
                                           class="btn
                                            btn-warning
                                            btn-sm">

                                            <i class="fas fa-edit"></i>
                                            Editar

                                        </a>

                                        @if (item.Estado)
                                        {
                                            <a asp-controller="Estudiantes"
                                               asp-action="Desactivar"
                                               asp-route-id="@item.IdEstudiante"
                                               class="btn
                                                btn-danger
                                                btn-sm"
                                               onclick="return confirm('¿Desea desactivar este estudiante?');">

                                                <i class="fas fa-user-times"></i>
                                                Desactivar

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Estudiantes"
                                               asp-action="Activar"
                                               asp-route-id="@item.IdEstudiante"
                                               class="btn
                                                btn-success
                                                btn-sm"
                                               onclick="return confirm('¿Desea activar este estudiante?');">

                                                <i class="fas fa-user-check"></i>
                                                Activar

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>