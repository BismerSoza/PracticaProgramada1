@model PracticaProgramada1.Models.EventoModel

@{
    ViewData["Title"] = "Registrar Evento";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">
                Registrar Evento
            </h3>
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Registrar"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="IdCurso"
                           class="form-label">
                        Curso
                    </label>

                    <select asp-for="IdCurso"
                            asp-items="ViewBag.Cursos"
                            class="form-select">

                        <option value="">
                            Seleccione un curso
                        </option>

                    </select>

                    <span asp-validation-for="IdCurso"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Titulo"
                           class="form-label">
                        Título
                    </label>

                    <input asp-for="Titulo"
                           class="form-control"
                           maxlength="150"
                           placeholder="Ingrese el título del evento" />

                    <span asp-validation-for="Titulo"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Descripcion"
                           class="form-label">
                        Descripción
                    </label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="4"
                              maxlength="500"
                              placeholder="Ingrese la descripción del evento"></textarea>

                    <span asp-validation-for="Descripcion"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="FechaEvento"
                           class="form-label">
                        Fecha y hora
                    </label>

                    <input asp-for="FechaEvento"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="FechaEvento"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Lugar"
                           class="form-label">
                        Lugar
                    </label>

                    <input asp-for="Lugar"
                           class="form-control"
                           maxlength="200"
                           placeholder="Ingrese el lugar del evento" />

                    <span asp-validation-for="Lugar"
                          class="text-danger">
                    </span>

                </div>

                <input asp-for="Estado"
                       type="hidden"
                       value="true" />

                <button type="submit"
                        class="btn btn-success">
                    Guardar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
