@model PracticaProgramada1.Models.NotificacionModel

@{
    ViewData["Title"] = "Registrar Notificación";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h3>Registrar Notificación</h3>
        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Registrar" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="IdUsuario" class="form-label">
                        Usuario
                    </label>

                    <input asp-for="IdUsuario"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="IdUsuario"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Asunto" class="form-label">
                        Asunto
                    </label>

                    <input asp-for="Asunto"
                           class="form-control" />

                    <span asp-validation-for="Asunto"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Mensaje" class="form-label">
                        Mensaje
                    </label>

                    <textarea asp-for="Mensaje"
                              class="form-control"
                              rows="5">
                    </textarea>

                    <span asp-validation-for="Mensaje"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Guardar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
