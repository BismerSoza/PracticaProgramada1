@model IEnumerable<PracticaProgramada1.Models.NotificacionModel>

@{
    ViewData["Title"] = "Notificaciones";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Lista de Notificaciones</h2>

        <a asp-action="Registrar"
           class="btn btn-success">
            Nueva Notificación
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay notificaciones registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Asunto</th>
                        <th>Estado</th>
                        <th>Fecha de envío</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.IdNotificacion</td>
                            <td>@item.IdUsuario</td>
                            <td>@item.Correo</td>
                            <td>@item.Asunto</td>

                            <td>
                                @if (item.Leida)
                                {
                                    <span class="badge bg-success">
                                        Leída
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pendiente
                                    </span>
                                }
                            </td>

                            <td>
                                @item.FechaEnvio.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <a asp-action="Detalle"
                                   asp-route-id="@item.IdNotificacion"
                                   class="btn btn-info btn-sm">
                                    Detalle
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>