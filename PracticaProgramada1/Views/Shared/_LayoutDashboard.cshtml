@{
    var controladorActual =
        ViewContext.RouteData.Values["controller"]?
            .ToString() ?? "";

    var accionActual =
        ViewContext.RouteData.Values["action"]?
            .ToString() ?? "";

    var nombre =
        Context.Session.GetString("Nombre") ?? "Usuario";

    var primerApellido =
        Context.Session.GetString("PrimerApellido") ?? "";

    var nombreCompleto =
        $"{nombre} {primerApellido}".Trim();

    var nombreRol =
        Context.Session.GetString("NombreRol") ?? "Usuario";

    bool EsControlador(string controlador)
    {
        return controladorActual.Equals(
            controlador,
            StringComparison.OrdinalIgnoreCase);
    }
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width,
    initial-scale=1,
    maximum-scale=1,
    shrink-to-fit=no">

    <title>
        @ViewData["Title"] - Sistema Escolar
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="~/css/all.min.css">

    <!-- Estilos de Stisla -->
    <link rel="stylesheet"
          href="~/css/style.css">

    <link rel="stylesheet"
          href="~/css/components.css">

    @RenderSection(
        "HeadStyles",
        required: false)

</head>

<body>

    <div id="app">

        <div class="main-wrapper main-wrapper-1">

            <!-- Fondo de la barra superior -->
            <div class="navbar-bg"></div>

            <!-- Barra superior -->
            <nav class="navbar navbar-expand-lg main-navbar">

                <ul class="navbar-nav mr-auto">

                    <li>

                        <a href="#"
                           data-toggle="sidebar"
                           class="nav-link nav-link-lg">

                            <i class="fas fa-bars"></i>

                        </a>

                    </li>

                </ul>

                <ul class="navbar-nav navbar-right">

                    <!-- Acceso rápido a notificaciones -->
                    <li>

                        <a asp-controller="Notificaciones"
                           asp-action="Index"
                           class="nav-link nav-link-lg"
                           title="Notificaciones">

                            <i class="far fa-bell"></i>

                        </a>

                    </li>

                    <!-- Usuario -->
                    <li class="dropdown">

                        <a href="#"
                           data-toggle="dropdown"
                           class="nav-link dropdown-toggle
                            nav-link-lg nav-link-user">

                            <div class="d-sm-none d-lg-inline-block">

                                Hola, @nombreCompleto

                            </div>

                        </a>

                        <div class="dropdown-menu dropdown-menu-right">

                            <div class="dropdown-title">

                                @nombreRol

                            </div>

                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="dropdown-item has-icon">

                                <i class="fas fa-home"></i>

                                Inicio

                            </a>

                            <a asp-controller="Notificaciones"
                               asp-action="Index"
                               class="dropdown-item has-icon">

                                <i class="far fa-bell"></i>

                                Notificaciones

                            </a>

                            <div class="dropdown-divider"></div>

                            <a asp-controller="Home"
                               asp-action="Salir"
                               class="dropdown-item has-icon text-danger">

                                <i class="fas fa-sign-out-alt"></i>

                                Cerrar sesión

                            </a>

                        </div>

                    </li>

                </ul>

            </nav>

            <!-- Menú lateral -->
            <div class="main-sidebar sidebar-style-2">

                <aside id="sidebar-wrapper">

                    <!-- Nombre completo -->
                    <div class="sidebar-brand">

                        <a asp-controller="Home"
                           asp-action="Dashboard">

                            Sistema Escolar

                        </a>

                    </div>

                    <!-- Nombre cuando el menú está cerrado -->
                    <div class="sidebar-brand sidebar-brand-sm">

                        <a asp-controller="Home"
                           asp-action="Dashboard">

                            SE

                        </a>

                    </div>

                    <ul class="sidebar-menu">

                        <!-- Inicio -->
                        <li class="menu-header">

                            Menú principal

                        </li>

                        <li class="@(EsControlador("Home")
                                                        && accionActual == "Dashboard"
                                                            ? "active"
                                                            : "")">

                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="nav-link">

                                <i class="fas fa-home"></i>

                                <span>Inicio</span>

                            </a>

                        </li>

                        <!-- Personas -->
                        <li class="menu-header">

                            Gestión de personas

                        </li>

                        <li class="@(EsControlador("Estudiantes")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Estudiantes"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-user-graduate"></i>

                                <span>Estudiantes</span>

                            </a>

                        </li>

                        <li class="@(EsControlador("Profesores")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Profesores"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-chalkboard-teacher"></i>

                                <span>Profesores</span>

                            </a>

                        </li>

                        <!-- Área académica -->
                        <li class="menu-header">

                            Gestión académica

                        </li>

                        <li class="@(EsControlador("Cursos")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Cursos"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-book"></i>

                                <span>Cursos</span>

                            </a>

                        </li>

                        <li class="@(EsControlador("Matriculas")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Matriculas"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-clipboard-list"></i>

                                <span>Matrículas</span>

                            </a>

                        </li>

                        <li class="@(EsControlador("Calificaciones")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Calificaciones"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-star"></i>

                                <span>Calificaciones</span>

                            </a>

                        </li>

                        <li class="@(EsControlador("Asistencias")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Asistencias"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-user-check"></i>

                                <span>Asistencias</span>

                            </a>

                        </li>

                        <!-- Comunicación -->
                        <li class="menu-header">

                            Comunicación

                        </li>

                        <li class="@(EsControlador("Eventos")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Eventos"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-calendar-alt"></i>

                                <span>Eventos</span>

                            </a>

                        </li>

                        <li class="@(EsControlador("Notificaciones")
                                                        ? "active"
                                                        : "")">

                            <a asp-controller="Notificaciones"
                               asp-action="Index"
                               class="nav-link">

                                <i class="fas fa-bell"></i>

                                <span>Notificaciones</span>

                            </a>

                        </li>

                        <!-- Sesión -->
                        <li class="menu-header">

                            Cuenta

                        </li>

                        <li>

                            <a asp-controller="Home"
                               asp-action="Salir"
                               class="nav-link text-danger">

                                <i class="fas fa-sign-out-alt"></i>

                                <span>Cerrar sesión</span>

                            </a>

                        </li>

                    </ul>

                    <!-- Información del usuario -->
                    <div class="mt-4 mb-4 p-3 hide-sidebar-mini">

                        <div class="card bg-light">

                            <div class="card-body p-3 text-center">

                                <i class="fas fa-user-circle
                                    fa-2x
                                    text-primary
                                    mb-2">
                                </i>

                                <div class="font-weight-bold">

                                    @nombreCompleto

                                </div>

                                <small class="text-muted">

                                    @nombreRol

                                </small>

                            </div>

                        </div>

                    </div>

                </aside>

            </div>

            <!-- Contenido de la página -->
            <div class="main-content">

                <section class="section">

                    @RenderBody()

                </section>

            </div>

            <!-- Pie de página -->
            <footer class="main-footer">

                <div class="footer-left">

                    Sistema Escolar
                    &copy;
                    @DateTime.Now.Year

                </div>

                <div class="footer-right">

                    Universidad

                </div>

            </footer>

        </div>

    </div>

    <!-- JavaScript -->
    <script src="~/js/jquery.min.js"></script>

    <script src="~/js/popper.js"></script>

    <script src="~/js/tooltip.js"></script>

    <script src="~/js/bootstrap.min.js"></script>

    <script src="~/js/jquery.nicescroll.min.js"></script>

    <script src="~/js/moment.min.js"></script>

    <script src="~/js/stisla.js"></script>

    <script src="~/js/scripts.js"></script>

    <script src="~/js/custom.js"></script>

    @RenderSection(
        "Scripts",
        required: false)

</body>

</html>
