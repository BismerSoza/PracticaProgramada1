@model IEnumerable<PracticaProgramada1.Models.AsistenciaModel>

@{
    ViewData["Title"] = "Asistencias";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Lista de Asistencias</h2>

        <a asp-action="Registrar"
           class="btn btn-success">
            Nueva Asistencia
        </a>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay asistencias registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Estudiante</th>
                        <th>Curso</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.IdAsistencia</td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Estudiante))
                                {
                                    @item.Estudiante
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Matrícula #@item.IdMatricula
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.NombreCurso))
                                {
                                    @item.NombreCurso
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin información
                                    </span>
                                }
                            </td>

                            <td>
                                @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @if (item.Estado == "Presente")
                                {
                                    <span class="badge bg-success">
                                        Presente
                                    </span>
                                }
                                else if (item.Estado == "Ausente")
                                {
                                    <span class="badge bg-danger">
                                        Ausente
                                    </span>
                                }
                                else if (item.Estado == "Tardía")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Tardía
                                    </span>
                                }
                                else if (item.Estado == "Justificada")
                                {
                                    <span class="badge bg-info text-dark">
                                        Justificada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Estado
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-action="Detalle"
                                   asp-route-id="@item.IdAsistencia"
                                   class="btn btn-info btn-sm">
                                    Detalle
                                </a>

                                <a asp-action="Editar"
                                   asp-route-id="@item.IdAsistencia"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-action="Eliminar"
                                   asp-route-id="@item.IdAsistencia"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('¿Desea eliminar esta asistencia?');">
                                    Eliminar
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>